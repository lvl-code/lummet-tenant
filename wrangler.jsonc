{
  "name": "freewin",
  "main": "en/worker/index.js",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  
  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "levelcasino-db",
      "database_id": "8e68c1f7-e284-415c-a67c-6ba0c5d0a1f8"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0557421566ac40a999c365bb6936a53f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "level-casino-media"
    }
  ],

  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }

}
