

/* Casino listing page */
.casino-list-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  flex-wrap: wrap;
  gap: 12px;
}
.casino-list-toolbar select {
  padding: 8px 14px;
  border: 1px solid var(--light-gray);
  border-radius: 8px;
  font-size: 14px;
  background: var(--white);
}

/* Rating stars display */
.stars {
  display: inline-flex;
  gap: 2px;
  color: var(--warning);
  font-size: 16px;
}
.stars .star-empty { color: var(--light-gray); }

/* Casino description */
.casino-description {
  color: var(--gray);
  font-size: 15px;
  line-height: 1.7;
}

/* Geo card states */
.geo-allowed { color: var(--success); font-weight: 600; }
.geo-blocked { color: var(--danger); font-weight: 600; }
.geo-restricted { color: var(--warning); font-weight: 600; }

/* Bonus override badge */
.bonus-override {
  background: var(--success);
  color: var(--white);
  padding: 4px 10px;
  border-radius: 8px;
  font-size: 12px;
  margin-top: 8px;
  display: inline-block;
}

/* Reviews list on casino page */
.review-item {
  background: var(--bg);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 12px;
}
.review-item h4 { margin-bottom: 6px; }
.review-item .review-rating { color: var(--warning); font-size: 14px; }
.review-item .review-excerpt { color: var(--gray); font-size: 14px; margin-top: 6px; }

/* ============================================================
   CASINO GRID + CASINO CARD
   Single source of truth for the casino listing component.
   Namespace: .casino-grid / .casino-card / .casino-card__*
   Consumed by: en/templates/components/casino_grid.html
   Do NOT duplicate these selectors in any other stylesheet.
   ============================================================ */

.casino-grid {
  display: grid;
  grid-template-columns: 1fr;               /* mobile: 1 per row */
  gap: 20px;
  align-items: stretch;
}

@media (min-width: 641px) {
  .casino-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)); /* tablet: 2 per row */
    gap: 22px;
  }
}

@media (min-width: 1025px) {
  .casino-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)); /* desktop: 3 per row */
    gap: 24px;
  }
}

/* ---------- Card shell ---------- */

.casino-card {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
  box-sizing: border-box;

  background: linear-gradient(165deg, #ffffff 0%, #fbfbff 58%, #f6f4ff 100%);
  border: 1px solid var(--support-border, var(--light-gray, #e2e8f0));
  border-radius: var(--support-radius-lg, 16px);
  box-shadow: var(--support-shadow-sm, 0 3px 10px rgba(15, 23, 42, .06));
  overflow: hidden;

  transition:
    transform .22s cubic-bezier(.2, .7, .2, 1),
    box-shadow .22s ease,
    border-color .22s ease;
}

.casino-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 3px;
  background: linear-gradient(90deg, var(--primary, #6c5ce7), #8b7cf6, #a78bfa);
  z-index: 1;
}

.casino-card:hover,
.casino-card:focus-within {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--primary, #6c5ce7) 24%, var(--support-border, #e2e8f0));
  box-shadow: var(--support-shadow-lg, 0 18px 50px rgba(15, 23, 42, .12));
}

/* ---------- Header: logo + name + rating ---------- */

.casino-card__header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px 18px 14px;
  min-width: 0;
}

/* Fixed-size, self-contained logo tile so logos of any aspect ratio
   line up consistently across cards. The <img> itself never crops. */
.casino-card__logo-wrap {
  flex: 0 0 60px;
  width: 60px;
  height: 60px;
  box-sizing: border-box;
  padding: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fff;
  border: 1px solid rgba(15, 23, 42, .08);
  border-radius: 14px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
}

.casino-card__logo {
  width: 100%;
  height: 100%;
  object-fit: contain;   /* never cropped/stretched */
  object-position: center;
  display: block;
}

.casino-card__title-group {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.casino-card__name {
  margin: 0;
  font-family: var(--support-font-display, inherit);
  font-size: clamp(16px, 1.4vw, 19px);
  font-weight: 700;
  letter-spacing: -.01em;
  line-height: 1.2;
  color: var(--support-text, var(--dark, #1a1a2e));
  overflow-wrap: anywhere;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.casino-card__rating {
  display: flex;
  align-items: center;
  gap: 2px;
  color: #b77900;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .02em;
  line-height: 1;
}

.casino-card__rating .star-empty {
  color: var(--light-gray, #e2e8f0);
}

/* ---------- Body: bonus + geo status ---------- */

.casino-card__body {
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 2px 18px 14px;
}

.casino-card__bonus {
  position: relative;
  margin-top: auto;
  min-width: 0;
  box-sizing: border-box;
  padding: 12px 15px 12px 17px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow: hidden;
  border-radius: 12px;
  border: 1px solid rgba(108, 92, 231, .14);
  background: linear-gradient(135deg, rgba(108, 92, 231, .10), rgba(139, 124, 246, .05));
}

.casino-card__bonus::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: linear-gradient(180deg, var(--primary, #6c5ce7), #a78bfa);
}

.bonus-title {
  color: #596579;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bonus-value {
  min-width: 0;
  color: #4f3cc9;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -.01em;
  line-height: 1.25;
  overflow-wrap: anywhere;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.casino-card__geo-status {
  margin-top: 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--support-muted, var(--gray, #64748b));
}

/* ---------- Actions ---------- */

.casino-card__actions {
  display: flex;
  gap: 10px;
  padding: 14px 18px 18px;
  margin-top: auto;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.casino-card__actions .btn {
  flex: 1 1 0;
  min-width: 0;
  min-height: 44px;
  padding: 9px 10px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.2;
  border-radius: 10px;
  white-space: normal;
  overflow-wrap: anywhere;
}

.casino-card__actions .btn--secondary {
  background: #fff;
  color: var(--primary, #6c5ce7);
  border: 1px solid rgba(108, 92, 231, .35);
}

.casino-card__actions .btn--secondary:hover {
  background: rgba(108, 92, 231, .06);
}

/* ---------- Badges: bookmark / promo / geo ---------- */

.casino-card__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 3;
  background: var(--primary, #6c5ce7);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 12px;
}

.geo-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 3;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.geo-badge__flag {
  font-size: 26px;
  line-height: 1;
}

.geo-badge__icon {
  position: absolute;
  font-size: 16px;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 0 4px #fff, 0 0 4px #fff, 0 0 4px #fff;
}

.geo-badge--allowed .geo-badge__icon { color: var(--success, #00b894); }
.geo-badge--blocked .geo-badge__icon { color: var(--danger, #e74c3c); }
.geo-badge--unknown .geo-badge__icon { color: var(--gray, #64748b); }

.casino-card__bookmark {
  position: absolute;
  top: 54px;
  right: 12px;
  z-index: 3;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(15, 23, 42, .10);
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  backdrop-filter: blur(6px);
  color: #8892a6;
  cursor: pointer;
  transition:
    transform .18s ease,
    background .18s ease,
    color .18s ease,
    border-color .18s ease;
}

.casino-card__bookmark:hover {
  transform: scale(1.08);
  color: var(--primary, #6c5ce7);
  border-color: rgba(108, 92, 231, .35);
}

.casino-card__bookmark:focus-visible {
  outline: 2px solid var(--primary, #6c5ce7);
  outline-offset: 2px;
}

.casino-card__bookmark .bookmark-icon {
  font-size: 20px;
  line-height: 1;
}

.casino-card__bookmark.is-bookmarked {
  color: #ff4fa3;
  background: rgba(255, 79, 163, .10);
  border-color: rgba(255, 79, 163, .35);
}

.casino-card__bookmark.is-bookmarked .bookmark-icon {
  color: #ff4fa3;
}

.casino-card__bookmark.is-loading {
  opacity: .6;
  cursor: wait;
}

.casino-card__bookmark:disabled {
  pointer-events: none;
}

/* ---------- Content safety net (long names/bonuses never overflow) ---------- */

.casino-card :where(p, span, div, a, strong, small, label) {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* ---------- Small mobile refinement ---------- */

@media (max-width: 420px) {
  .casino-card__header { padding: 16px 14px 12px; gap: 11px; }
  .casino-card__logo-wrap { flex-basis: 52px; width: 52px; height: 52px; }
  .casino-card__body { padding-left: 14px; padding-right: 14px; }
  .casino-card__actions { padding: 12px 14px 14px; gap: 8px; }
}

/* ---------- Accessibility ---------- */

@media (prefers-reduced-motion: reduce) {
  .casino-card,
  .casino-card__bookmark {
    transition: none;
  }
  .casino-card:hover,
  .casino-card__bookmark:hover {
    transform: none;
  }
}
