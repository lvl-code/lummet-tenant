{
  "name": "freewin",
  "main": "en/worker/index.js",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  
  "assets": {
    "binding": "ASSETS",
    "directory": "./en",
    "run_worker_first": true
  },

  "d1_databases": [{
    "binding": "DB",
    "database_name": "freewin-db",
    "database_id": "8aa163e4-7dc1-4539-b505-b1b43b021e30"
 }],
  "ai": {
    "binding": "AI"
  },
  
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b8a8a5da18074de9890a62e3db56908c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "level-casino-media"
    }
  ],

  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }

}
