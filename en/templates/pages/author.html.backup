<section class="author-profile">
  <div class="container">
    <div class="author-hero" style="display:flex;gap:24px;align-items:center;background:var(--white);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow);margin-bottom:30px">
      <img src="{{author_avatar}}" alt="{{author_name}}" style="width:100px;height:100px;border-radius:50%;object-fit:cover" onerror="this.src='/static/images/logo.png'">
      <div>
        <h1>{{author_name}}</h1>
        <p style="color:var(--primary);font-weight:600;font-size:16px">{{author_role}}</p>
        <p style="color:var(--gray);margin-top:8px">{{author_bio}}</p>
        {{#if author_social}}
        <div style="margin-top:12px">{{author_social}}</div>
        {{/if}}
      </div>
    </div>

    <div style="display:flex;gap:16px;margin-bottom:30px">
      <div class="stat-card" style="flex:1">
        <div class="stat-value">{{review_count}}</div>
        <div class="stat-label">Reviews</div>
      </div>
      <div class="stat-card" style="flex:1">
        <div class="stat-value">{{news_count}}</div>
        <div class="stat-label">Articles</div>
      </div>
      <div class="stat-card" style="flex:1">
        <div class="stat-value">{{page_count}}</div>
        <div class="stat-label">Pages</div>
      </div>
    </div>

    {{components_top}}

    {{#if review_count}}
    <div style="margin-bottom:40px">
      <h2>Reviews by {{author_name}}</h2>
      <div class="casino-grid" style="margin-top:20px">
        {{review_cards}}
      </div>
    </div>
    {{/if}}

    {{components_content_top}}

    {{#if news_count}}
    <div style="margin-bottom:40px">
      <h2>Articles by {{author_name}}</h2>
      <div class="news-grid" style="margin-top:20px">
        {{news_cards}}
      </div>
    </div>
    {{/if}}

    {{#if page_count}}
    <div style="margin-bottom:40px">
      <h2>Pages by {{author_name}}</h2>
      <ul style="list-style:none;padding:0;margin-top:20px">
        {{page_list}}
      </ul>
    </div>
    {{/if}}

    {{components_content_bottom}}
    {{components_bottom}}
  </div>
</section>
